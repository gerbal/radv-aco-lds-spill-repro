+
+BEGIN_TEST(scheduler.lds_spill_order)
+   /* VGPR spills to LDS and their reloads, as aco_spill.cpp creates them, must stay in order
+    * against the other spills and reloads of their slot. With no memory_sync_info on them, load1's
+    * downward pass moved the reload of a and the spill of a below load1, while the spill of b
+    * stayed (load1's address is b's last use): the spill of a came after the spill of b, and the
+    * reload of b read a.
+    */
+   //>> v1: %base:v[0],  s4: %rsrc:s[0-3] = p_startpgm
+   if (!setup_cs("v1 s4", GFX10_3))
+      return;
+
+   memory_sync_info spill_sync(storage_shared, semantic_private);
+
+   bld.pseudo(aco_opcode::p_logical_start);
+   Temp m0_zero = bld.copy(bld.def(s1, m0), Operand::zero());
+   //>> v1: %a = v_xor_b32 1, %base
+   //>> v1: %b = v_xor_b32 2, %base
+   Temp a = bld.vop2(aco_opcode::v_xor_b32, bld.def(v1), Operand::c32(1), inputs[0]);
+   Temp b = bld.vop2(aco_opcode::v_xor_b32, bld.def(v1), Operand::c32(2), inputs[0]);
+   Temp c = bld.vop2(aco_opcode::v_xor_b32, bld.def(v1), Operand::c32(3), inputs[0]);
+
+   //>> s1: %m0_zero:m0 = p_parallelcopy 0
+   //>> ds_write_addtid_b32 %m0_zero:m0, %a storage:shared semantics:private
+   //>> v1: %reload_a = ds_read_addtid_b32 %m0_zero:m0 storage:shared semantics:private
+   //>> ds_write_addtid_b32 %m0_zero:m0, %b storage:shared semantics:private
+   //>> v1: %reload_b = ds_read_addtid_b32 %m0_zero:m0 storage:shared semantics:private
+   //>> v1: %sum = v_add_u32 %reload_a, %mul
+   //>> p_unit_test 2, %reload_b
+   bld.ds(aco_opcode::ds_write_addtid_b32, bld.m0(m0_zero), a, 0)->ds().sync = spill_sync;
+   Temp addr0 = bld.vop2(aco_opcode::v_lshlrev_b32, bld.def(v1), Operand::c32(2), inputs[0]);
+   Temp load0 = bld.mubuf(aco_opcode::buffer_load_dword, bld.def(v1), Operand(inputs[1]),
+                          Operand(addr0), Operand::zero(), 0, true);
+   Temp mul = bld.vop3(aco_opcode::v_mul_lo_u32, bld.def(v1), c, load0);
+   Builder::Result reload_a =
+      bld.ds(aco_opcode::ds_read_addtid_b32, bld.def(v1), bld.m0(m0_zero), 0);
+   reload_a->ds().sync = spill_sync;
+   Temp sum = bld.vop2(aco_opcode::v_add_u32, bld.def(v1), reload_a, mul);
+   bld.ds(aco_opcode::ds_write_addtid_b32, bld.m0(m0_zero), b, 0)->ds().sync = spill_sync;
+   Temp addr1 = bld.vop2(aco_opcode::v_add_u32, bld.def(v1), Operand::c32(0x120), b);
+   Temp load1 = bld.mubuf(aco_opcode::buffer_load_dword, bld.def(v1), Operand(inputs[1]),
+                          Operand(addr1), Operand::zero(), 0, true);
+   Builder::Result reload_b =
+      bld.ds(aco_opcode::ds_read_addtid_b32, bld.def(v1), bld.m0(m0_zero), 0);
+   reload_b->ds().sync = spill_sync;
+
+   bld.pseudo(aco_opcode::p_unit_test, Operand::zero(), sum);
+   bld.pseudo(aco_opcode::p_unit_test, Operand::c32(1), load1);
+   bld.pseudo(aco_opcode::p_unit_test, Operand::c32(2), reload_b);
+   bld.pseudo(aco_opcode::p_logical_end);
+
+   finish_schedule_test();
+END_TEST
+
+BEGIN_TEST(scheduler.lds_spill_order_up)
+   /* The same for a reload and its own spill. With no memory_sync_info on them, the load's upward
+    * pass moved the reload of v above the spill of v.
+    */
+   //>> v1: %base:v[0],  s4: %rsrc:s[0-3] = p_startpgm
+   if (!setup_cs("v1 s4", GFX10_3))
+      return;
+
+   memory_sync_info spill_sync(storage_shared, semantic_private);
+
+   bld.pseudo(aco_opcode::p_logical_start);
+   Temp m0_zero = bld.copy(bld.def(s1, m0), Operand::zero());
+   Temp addr = bld.vop2(aco_opcode::v_lshlrev_b32, bld.def(v1), Operand::c32(2), inputs[0]);
+
+   //>> v1: %v = buffer_load_dword %rsrc, %_, 0 offen
+   //>> ds_write_addtid_b32 %_:m0, %v storage:shared semantics:private
+   //>> v1: %reload_v = ds_read_addtid_b32 %_:m0 storage:shared semantics:private
+   //>> p_unit_test 0, %reload_v
+   Temp v = bld.mubuf(aco_opcode::buffer_load_dword, bld.def(v1), Operand(inputs[1]),
+                      Operand(addr), Operand::zero(), 0, true);
+   bld.ds(aco_opcode::ds_write_addtid_b32, bld.m0(m0_zero), v, 0)->ds().sync = spill_sync;
+   Temp x = bld.vop2(aco_opcode::v_xor_b32, bld.def(v1), Operand::c32(5), inputs[0]);
+   Builder::Result reload_v =
+      bld.ds(aco_opcode::ds_read_addtid_b32, bld.def(v1), bld.m0(m0_zero), 0);
+   reload_v->ds().sync = spill_sync;
+   Builder::Result reload_w =
+      bld.ds(aco_opcode::ds_read_addtid_b32, bld.def(v1), bld.m0(m0_zero), 256);
+   reload_w->ds().sync = spill_sync;
+
+   bld.pseudo(aco_opcode::p_unit_test, Operand::zero(), reload_v);
+   bld.pseudo(aco_opcode::p_unit_test, Operand::c32(1), x);
+   bld.pseudo(aco_opcode::p_unit_test, Operand::c32(2), reload_w);
+   bld.pseudo(aco_opcode::p_logical_end);
+
+   finish_schedule_test();
+END_TEST
