+ * SPDX-License-Identifier: MIT
+ */
+
+#include "helpers.h"
+
+using namespace aco;
+
+BEGIN_TEST(spill.lds_sync)
+   /* A single-wave compute shader with LDS to spare spills VGPRs to LDS. The spills and reloads
+    * need a memory_sync_info the scheduler orders, or it can reorder a spill and a reload of the
+    * same slot (see scheduler.lds_spill_order and scheduler.lds_spill_order_up).
+    */
+   //>> v1: %base:v[0] = p_startpgm
+   if (!setup_cs("v1", GFX10_3))
+      return;
+
+   std::vector<Temp> vals;
+   for (unsigned i = 0; i < 260; i++)
+      vals.push_back(bld.vop2(aco_opcode::v_xor_b32, bld.def(v1), Operand::c32(i), inputs[0]));
+   for (unsigned i = 260; i-- > 0;)
+      bld.pseudo(aco_opcode::p_unit_test, Operand::c32(i), vals[i]);
+
+   //>> s1: %m0_zero:m0 = p_parallelcopy 0
+   //! ds_write_addtid_b32 %m0_zero:m0, (kill)%_ storage:shared semantics:private
+   //>> v1: %_ = ds_read_addtid_b32 %m0_zero:m0 offset0:# storage:shared semantics:private
+   finish_spill_test();
+END_TEST
+
+BEGIN_TEST(spill.lds_sync_multi_dword)
+   /* The same for a value of more than one dword, which is spilled and reloaded a dword at a
+    * time.
+    */
+   //>> v1: %base:v[0] = p_startpgm
+   if (!setup_cs("v1", GFX10_3))
+      return;
+
+   std::vector<Temp> vals;
+   for (unsigned i = 0; i < 130; i++) {
+      Temp lo = bld.vop2(aco_opcode::v_xor_b32, bld.def(v1), Operand::c32(i * 2), inputs[0]);
+      Temp hi = bld.vop2(aco_opcode::v_xor_b32, bld.def(v1), Operand::c32(i * 2 + 1), inputs[0]);
+      vals.push_back(bld.pseudo(aco_opcode::p_create_vector, bld.def(v2), lo, hi));
+   }
+   for (unsigned i = 130; i-- > 0;)
+      bld.pseudo(aco_opcode::p_unit_test, Operand::c32(i), vals[i]);
+
+   //>> s1: %m0_zero:m0 = p_parallelcopy 0
+   //! v1: %lo,  v1: %hi = p_split_vector (kill)%_
+   //! ds_write_addtid_b32 %m0_zero:m0, (kill)%lo storage:shared semantics:private
+   //! ds_write_addtid_b32 %m0_zero:m0, (kill)%hi offset0:256 storage:shared semantics:private
+   //>> v1: %rlo = ds_read_addtid_b32 %m0_zero:m0 offset0:# storage:shared semantics:private
+   //! v1: %rhi = ds_read_addtid_b32 %m0_zero:m0 offset0:# storage:shared semantics:private
+   //! v2: %_ = p_create_vector (kill)%rlo, (kill)%rhi
+   finish_spill_test();
+END_TEST
